{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://0x2alx.github.io/snug-site/layout.schema.json",
  "title": "Snug layout",
  "description": "A widget layout for the Snug Android app, or a {\"configs\": [...]} list of them, optionally with the app theme. Documented at https://0x2alx.github.io/snug-site/ai.html",
  "oneOf": [
    { "$ref": "#/$defs/layout" },
    {
      "type": "object",
      "required": ["configs"],
      "properties": {
        "configs": { "type": "array", "items": { "$ref": "#/$defs/layout" } },
        "icons": { "$ref": "#/$defs/icons" },
        "theme": { "$ref": "#/$defs/theme" }
      }
    },
    { "type": "array", "items": { "$ref": "#/$defs/layout" } },
    {
      "description": "The app theme alone.",
      "type": "object",
      "required": ["theme"],
      "properties": { "theme": { "$ref": "#/$defs/theme" } },
      "not": { "anyOf": [{ "required": ["items"] }, { "required": ["configs"] }] }
    }
  ],
  "$defs": {
    "theme": {
      "description": "The look of the Snug app itself (its screens, not the widgets). See ai.html, The app theme.",
      "type": "object",
      "properties": {
        "selectedId": { "type": "string", "description": "graphite, daylight, neon, clumsy-clanker, high-contrast, or the id of a custom theme." },
        "matchPhone": { "type": "boolean" },
        "custom": { "type": "array", "items": { "$ref": "#/$defs/appTheme" } }
      }
    },
    "appTheme": {
      "type": "object",
      "properties": {
        "id": { "type": "string" }, "name": { "type": "string" }, "dark": { "type": "boolean" },
        "background": { "$ref": "#/$defs/color" }, "surface": { "$ref": "#/$defs/color" }, "surfaceVariant": { "$ref": "#/$defs/color" },
        "border": { "$ref": "#/$defs/color" }, "accent": { "$ref": "#/$defs/color" }, "onAccent": { "$ref": "#/$defs/color" },
        "text": { "$ref": "#/$defs/color" }, "mutedText": { "$ref": "#/$defs/color" }, "danger": { "$ref": "#/$defs/color" },
        "font": { "$ref": "#/$defs/appFont" },
        "headingFont": { "$ref": "#/$defs/appFont", "description": "Older name for font." }, "bodyFont": { "$ref": "#/$defs/appFont", "description": "Older name for font." },
        "textScalePct": { "type": "integer", "minimum": 85, "maximum": 130 },
        "cornerDp": { "type": "integer", "minimum": 0, "maximum": 28 },
        "borderDp": { "type": "integer", "minimum": 0, "maximum": 3 }
      }
    },
    "appFont": { "type": "string", "description": "One font for all the app's text: Phone default, Condensed, Serif, Mono, Audiowide, Oxanium, Orbitron, Michroma, Tektur, Rajdhani, Chakra Petch, Share Tech Mono. Case and spaces don't matter." },
    "color": {
      "description": "\"#RRGGBB\" or \"#AARRGGBB\" (alpha first).",
      "type": "string",
      "pattern": "^#([0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$"
    },
    "titleFont": { "enum": ["default", "condensed", "medium", "serif", "monospace", "casual", "cursive", "smallCaps", "audiowide", "oxanium", "orbitron", "michroma", "tektur", "rajdhani", "chakraPetch", "shareTechMono"] },
    "titleAlign": { "enum": ["start", "center", "end"] },
    "sectionStyle": {
      "description": "Overrides any widget setting for one section only: title style, spacing, and the widget-level settings below. Every field is optional; a missing or null field follows the widget.",
      "type": "object",
      "properties": {
        "colorArgb": { "anyOf": [{ "$ref": "#/$defs/color" }, { "type": "null" }], "default": null, "description": "Title colour, in day and dark mode alike." },
        "sizeSp": { "type": ["integer", "null"], "minimum": 8, "maximum": 24, "default": null },
        "bold": { "type": ["boolean", "null"], "default": null },
        "font": { "anyOf": [{ "$ref": "#/$defs/titleFont" }, { "type": "null" }], "default": null },
        "align": { "anyOf": [{ "$ref": "#/$defs/titleAlign" }, { "type": "null" }], "default": null },
        "gapXDp": { "type": ["integer", "null"], "minimum": 0, "maximum": 32, "default": null, "description": "Space between this section's icons across. Replaces gapDp there, so it can change the column count." },
        "gapYDp": { "type": ["integer", "null"], "minimum": 0, "maximum": 32, "default": null, "description": "Space between this section's rows. Gaps around titles stay gapDp." },
        "iconSizeDp": { "type": ["integer", "null"], "minimum": 16, "maximum": 96, "default": null, "description": "Largest icon size in this section. The section keeps it when a grid shrinks." },
        "layout": { "$ref": "#/$defs/layout/properties/layout", "description": "This section's layout, same shape as the widget's." },
        "labels": { "$ref": "#/$defs/layout/properties/labels", "description": "This section's labels, same shape as the widget's." },
        "background": { "$ref": "#/$defs/layout/properties/background", "description": "This section's own background, same shape as the widget's." },
        "iconStyle": { "$ref": "#/$defs/layout/properties/iconStyle", "description": "This section's icon style, same shape as the widget's." },
        "iconPack": { "type": ["string", "null"], "default": null, "description": "Icon pack package for this section. \"\" = the apps' own icons in this section." },
        "shape": { "$ref": "#/$defs/layout/properties/shape", "description": "This section's icon shape." },
        "order": { "$ref": "#/$defs/layout/properties/order", "description": "How this section's apps are sorted." },
        "night": { "$ref": "#/$defs/layout/properties/night", "description": "This section's dark-mode colours, same shape as the widget's." },
        "badge": { "$ref": "#/$defs/layout/properties/badge", "description": "This section's badge, same shape as the widget's." }
      }
    },
    "layout": {
      "type": "object",
      "required": ["items"],
      "properties": {
        "widgetId": { "type": "integer", "default": 0, "description": "Id of an existing widget to change in place. Omit or 0 for a new saved layout." },
        "name": { "type": "string", "default": "" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/item" }, "description": "In display order." },
        "icons": { "$ref": "#/$defs/icons" },
        "theme": { "$ref": "#/$defs/theme" },
        "layout": {
          "default": { "type": "auto" },
          "oneOf": [
            { "type": "object", "required": ["type"], "properties": { "type": { "const": "auto" } } },
            {
              "type": "object",
              "required": ["type", "rows", "cols"],
              "properties": {
                "type": { "const": "fixed" },
                "rows": { "type": "integer", "minimum": 1, "maximum": 8 },
                "cols": { "type": "integer", "minimum": 1, "maximum": 12 }
              }
            }
          ]
        },
        "iconSizeDp": { "type": "integer", "minimum": 16, "maximum": 96, "default": 40, "description": "Largest icon size." },
        "gapDp": { "type": "integer", "minimum": 0, "maximum": 32, "default": 4 },
        "shape": { "enum": ["original", "circle", "squircle", "rounded", "teardrop"], "default": "original" },
        "labels": {
          "type": "object",
          "default": { "show": false, "colorArgb": "#FFFFFF", "sizeSp": 11 },
          "properties": {
            "show": { "type": "boolean", "default": false },
            "colorArgb": { "$ref": "#/$defs/color", "default": "#FFFFFF" },
            "sizeSp": { "type": "integer", "minimum": 8, "maximum": 16, "default": 11, "description": "Section titles use this size too, unless titles.sizeSp is set." },
            "sectionArgb": { "anyOf": [{ "$ref": "#/$defs/color" }, { "type": "null" }], "default": null, "description": "Section titles and dividers. Null uses colorArgb." }
          }
        },
        "titles": {
          "type": "object",
          "default": { "sizeSp": null, "bold": true, "font": "default", "align": "center" },
          "description": "Section title style for the whole widget. Colour comes from labels.sectionArgb (night.sectionArgb in dark mode). A section's own style overrides it.",
          "properties": {
            "sizeSp": { "type": ["integer", "null"], "minimum": 8, "maximum": 24, "default": null, "description": "Null uses labels.sizeSp." },
            "bold": { "type": "boolean", "default": true },
            "font": { "$ref": "#/$defs/titleFont", "default": "default" },
            "align": { "$ref": "#/$defs/titleAlign", "default": "center" }
          }
        },
        "sectionGapDp": { "type": "integer", "minimum": 0, "maximum": 32, "default": 8, "description": "Space between side-by-side sections and between grid rows." },
        "background": {
          "type": "object",
          "default": { "kind": "transparent", "colorArgb": "#000000", "alphaPct": 60, "cornerDp": 16 },
          "properties": {
            "kind": { "enum": ["transparent", "solid", "card"], "default": "transparent" },
            "colorArgb": { "$ref": "#/$defs/color", "default": "#000000" },
            "alphaPct": { "type": "integer", "minimum": 0, "maximum": 100, "default": 60 },
            "cornerDp": { "type": "integer", "minimum": 0, "maximum": 48, "default": 16 }
          }
        },
        "iconStyle": {
          "default": { "type": "original" },
          "oneOf": [
            { "type": "object", "required": ["type"], "properties": { "type": { "const": "original" } } },
            {
              "type": "object",
              "required": ["type", "tintArgb"],
              "properties": { "type": { "const": "themed" }, "tintArgb": { "$ref": "#/$defs/color" } }
            }
          ]
        },
        "iconPack": { "type": ["string", "null"], "default": null, "description": "Package name of an installed icon pack, or null." },
        "order": { "enum": ["manual", "alphabetical", "mostUsed"], "default": "manual" },
        "overflow": { "enum": ["shrink", "scroll"], "default": "shrink" },
        "badge": {
          "type": "object",
          "default": { "style": "number", "colorArgb": "#E53935", "sizePct": 100, "corner": "topEnd" },
          "properties": {
            "style": { "enum": ["number", "dot", "off"], "default": "number" },
            "colorArgb": { "$ref": "#/$defs/color", "default": "#E53935" },
            "sizePct": { "type": "integer", "minimum": 60, "maximum": 150, "default": 100 },
            "corner": { "enum": ["topStart", "topEnd", "bottomStart", "bottomEnd"], "default": "topEnd" }
          }
        },
        "night": {
          "type": ["object", "null"],
          "default": null,
          "description": "Colours used instead in dark mode.",
          "properties": {
            "backgroundArgb": { "$ref": "#/$defs/color", "default": "#000000" },
            "labelArgb": { "$ref": "#/$defs/color", "default": "#FFFFFF" },
            "tintArgb": { "$ref": "#/$defs/color", "default": "#FFFFFF" },
            "sectionArgb": { "anyOf": [{ "$ref": "#/$defs/color" }, { "type": "null" }], "default": null, "description": "Null uses labelArgb." }
          }
        }
      }
    },
    "item": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "packageName", "label"],
          "properties": {
            "type": { "const": "app" },
            "packageName": { "type": "string", "minLength": 1 },
            "label": { "type": "string" },
            "activityName": { "type": "string", "description": "Optional; Snug finds the launcher activity itself." },
            "icon": { "$ref": "#/$defs/icon" }
          }
        },
        {
          "type": "object",
          "required": ["type"],
          "description": "Starts a titled group. A blank label draws a thin divider.",
          "properties": {
            "type": { "const": "section" },
            "label": { "type": "string", "default": "", "description": "Emoji are welcome." },
            "sameRow": { "type": "boolean", "default": false, "description": "Sit to the right of the section before it instead of below. Rows of side-by-side sections make a grid. Up to 12 sections per widget." },
            "width": { "type": "integer", "minimum": 1, "maximum": 6, "default": 1, "description": "This section's share of its row (only matters in a row with other sections)." },
            "style": { "$ref": "#/$defs/sectionStyle" }
          }
        },
        {
          "type": "object",
          "required": ["type", "label", "url"],
          "properties": {
            "type": { "const": "link" },
            "label": { "type": "string" },
            "url": { "type": "string" },
            "icon": { "$ref": "#/$defs/icon" }
          }
        }
      ]
    },
    "icon": {
      "description": "A custom icon. Leave it out for the app's own icon, or a link's letter tile.",
      "type": "object",
      "required": ["type", "file"],
      "properties": {
        "type": { "const": "image" },
        "file": { "type": "string", "description": "A key in the top-level \"icons\" map, like \"reddit\"." }
      }
    },
    "icons": {
      "type": "object",
      "description": "Images for custom icons, by key: a PNG, JPEG or WebP as base64 (a data: URL works too). Square, about 256 px, with its own background colour, since it fills the whole icon shape. Only for AI agents that can download images and check them.",
      "additionalProperties": { "type": "string" }
    }
  }
}
